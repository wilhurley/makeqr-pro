# Copy to .env.local. Never commit real values.

# Stripe secret key, or a restricted key (rk_) with Checkout, Customers,
# Subscriptions, Billing Portal, and Webhook permissions.
STRIPE_SECRET_KEY=

# Price id for NEW Pro checkouts: recurring $3.99 / month. Leave the old $4.99 Price in place.
# Without this and STRIPE_SECRET_KEY the site shows "Pro coming soon" + a waitlist email.
STRIPE_PRO_PRICE_ID=

# Optional. Recurring $29 / year Price. The yearly plan only shows when set.
STRIPE_PRO_YEARLY_PRICE_ID=
# Yearly stays hidden until this is "on". Turn on only after the 15-45 day renewal reminder email works.
YEARLY_PLANS_ENABLED=

# Optional. One-time $39 Price (Checkout mode "payment"). Shown as "Launch lifetime deal, limited" only when set.
STRIPE_PRO_LIFETIME_PRICE_ID=


# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID is no longer read (it was the old $4.99 Price).
# Without STRIPE_PRO_PRICE_ID, Pro shows "coming soon" and checkout charges nobody.

# Optional: Stripe customer-portal login link. Used for Manage billing on browsers
# that restored Pro by email (Stripe emails the customer a sign-in code).
# STRIPE_BILLING_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/...

# Signing secret for https://makeqr.pro/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=

# HMAC secret for the Pro cookie. Generate with: openssl rand -base64 32
PRO_COOKIE_SECRET=

# Public origin used for Checkout and Billing Portal return URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=https://makeqr.pro

# Display price in US cents. Default 399 = $3.99. Must match STRIPE_PRO_PRICE_ID. Rebuild after changing.
NEXT_PUBLIC_PRO_PRICE_CENTS=399

# Optional display prices for the yearly and lifetime plans, in US cents. Must match their Stripe Prices.
NEXT_PUBLIC_PRO_YEARLY_PRICE_CENTS=2900
NEXT_PUBLIC_PRO_LIFETIME_PRICE_CENTS=3900
